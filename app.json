{
  "expo": {
    "name": "Dr. Ashraf Content Planner",
    "slug": "dr-ashraf-content-planner",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ashrafmetwally.contentplanner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF9FB"
      },
      "package": "com.ashrafmetwally.contentplanner"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9FB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
